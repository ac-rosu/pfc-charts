{
  "name": "pfc-charts",
  "version": "1.0.0",
  "description": "Render ISA-88 Procedure Function Charts from text in Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node esbuild.tests.mjs && node --test \"tests-dist/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": [
    "obsidian",
    "isa-88",
    "pfc",
    "sfc",
    "diagram"
  ],
  "license": "MIT",
  "author": "ACRO",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "eslint": "^9.39.5",
    "obsidian": "^1.4.11",
    "prettier": "^3.9.6",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.69.0"
  }
}
