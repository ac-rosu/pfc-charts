{
  "name": "pfc-charts",
  "displayName": "PFC Charts (ISA-88)",
  "description": "Render ISA-88 Procedure Function Charts from `pfc` code blocks in the Markdown preview.",
  "version": "1.3.0",
  "publisher": "acro",
  "license": "MIT",
  "author": "ACRO",
  "repository": {
    "type": "git",
    "url": "https://github.com/ac-rosu/pfc-charts"
  },
  "bugs": {
    "url": "https://github.com/ac-rosu/pfc-charts/issues"
  },
  "homepage": "https://github.com/ac-rosu/pfc-charts#readme",
  "icon": "media/icon.png",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#4338ca",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "isa-88",
    "pfc",
    "sfc",
    "markdown",
    "diagram"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/pfc-preview.css"
    ],
    "markdown.previewScripts": [
      "./media/pfc-preview.js"
    ]
  },
  "devDependencies": {
    "@pfc/core": "*"
  }
}
